{
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "baseUrl": "./docs",
    "paths": {
      "vue": ["./node_modules/vue/dist/vue.d.ts"],
      "vue-router": ["./node_modules/vue-router/dist/vue-router.d.ts"]
    },
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "docs/js/**/*.js"
  ]
}
